{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Positioning Case",
  "type": "object",
  "required": ["case_id","brand","category","target_audience","competitive_frame","current_position","desired_position","point_of_difference","reasons_to_believe","opportunity_score","sources","claims","counter_evidence"],
  "properties": {
    "case_id": {"type":"string","minLength":1},
    "brand": {"type":"string","minLength":1},
    "category": {"type":"string","minLength":1},
    "target_audience": {"type":"string","minLength":1},
    "competitive_frame": {"type":"string","minLength":1},
    "current_position": {"type":"string"},
    "desired_position": {"type":"string"},
    "point_of_difference": {"type":"string"},
    "reasons_to_believe": {"type":"array","items":{"type":"string"}},
    "opportunity_score": {
      "type":"object",
      "required":["relevance","differentiation","credibility","strategic_fit","economics","defensibility","execution"],
      "properties":{
        "relevance":{"$ref":"#/$defs/score"},
        "differentiation":{"$ref":"#/$defs/score"},
        "credibility":{"$ref":"#/$defs/score"},
        "strategic_fit":{"$ref":"#/$defs/score"},
        "economics":{"$ref":"#/$defs/score"},
        "defensibility":{"$ref":"#/$defs/score"},
        "execution":{"$ref":"#/$defs/score"}
      },
      "additionalProperties":false
    },
    "hard_gates":{"type":"array","items":{"type":"string"}},
    "sources":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["source_id","title","grade"],
        "properties":{
          "source_id":{"type":"string"},
          "title":{"type":"string"},
          "url":{"type":["string","null"]},
          "source_type":{"type":"string"},
          "grade":{"enum":["A","B","C","D"]},
          "synthetic":{"type":"boolean"},
          "limitations":{"type":"array","items":{"type":"string"}}
        },
        "additionalProperties":true
      }
    },
    "claims":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["claim_id","claim","source_ids","evidence_grade","attribution_grade"],
        "properties":{
          "claim_id":{"type":"string"},
          "claim":{"type":"string"},
          "source_ids":{"type":"array","items":{"type":"string"}},
          "evidence_grade":{"enum":["A","B","C","D"]},
          "attribution_grade":{"enum":["A","B","C","D"]},
          "period":{"type":["string","null"]},
          "limitations":{"type":"array","items":{"type":"string"}}
        },
        "additionalProperties":true
      }
    },
    "counter_evidence":{"type":"array","items":{"type":"string"}},
    "unknowns":{"type":"array","items":{"type":"string"}},
    "notes":{"type":"array","items":{"type":"string"}}
  },
  "$defs":{"score":{"type":"integer","minimum":1,"maximum":5}},
  "additionalProperties":true
}
